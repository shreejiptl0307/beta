# ==============================================================================
# Telegram Bot Configuration
# 1. Create a bot via @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your Chat ID by messaging @userinfobot on Telegram
# ==============================================================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example
TELEGRAM_CHAT_ID=1234567890

# ==============================================================================
# LLM Provider Configuration
# Options:
#  - auto          : Auto-detects Claude Code CLI first, then API keys, then deterministic fallback
#  - claude_code   : Use local Claude CLI (no API key needed, uses Claude subscription)
#  - anthropic     : Use Anthropic Messages API (requires ANTHROPIC_API_KEY)
#  - openai        : Use OpenAI Chat Completions (requires OPENAI_API_KEY)
#  - deterministic : Use built-in offline quantitative scoring rules
# ==============================================================================
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=sk-ant-api03-example-key-here
OPENAI_API_KEY=sk-proj-example-key-here
CLAUDE_MODEL=haiku

# ==============================================================================
# Application & Agent Pipeline Settings
# ==============================================================================
BRAND=Antigravity Alpha
CONFIDENCE_THRESHOLD=7
SHORTLIST_PER_BUCKET=0       # 0 = analyze all stocks across the universe
SEND_DAILY_SUMMARY=false     # Set to true to receive daily summary recaps on Telegram
AGENT_DELAY=0.2              # Pacing delay in seconds between agent animations
PORT=5050
HOST=127.0.0.1
