# Telegram Bot Configuration (Get token from @BotFather, Chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM Configuration (Optional: claude_code CLI is auto-detected first if available)
# Options: auto | claude_code | anthropic | openai | deterministic
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODEL=haiku

# Application Settings
BRAND=Antigravity Alpha
CONFIDENCE_THRESHOLD=7
SHORTLIST_PER_BUCKET=4
AGENT_DELAY=0.4
PORT=5050
HOST=127.0.0.1
